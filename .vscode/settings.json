{
  "C_Cpp_Runner.cCompilerPath": "C:/MinGW/bin/gcc.exe",
  "C_Cpp_Runner.cppCompilerPath": "C:/MinGW/bin/g++.exe",
  "C_Cpp_Runner.debuggerPath": "C:/MinGW/bin/gdb.exe",
  "C_Cpp_Runner.cStandard": "c11", // or leave blank if you want defaults
  "C_Cpp_Runner.cppStandard": "c++17", // or leave blank if you want defaults
  "C_Cpp_Runner.enableWarnings": true,
  "C_Cpp_Runner.warnings": [
      "-Wall",
      "-Wextra",
      "-Wpedantic"
  ],
  "files.associations": {
    "*.cpp": "cpp",
    "*.h": "cpp",
    "unordered_map": "cpp",
    "fstream": "cpp",
    "iostream": "cpp",
    "ostream": "cpp",
    "thread": "cpp"
  }
}
